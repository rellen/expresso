classDiagram
    namespace Reef {
        class Turtle {
            +String shellColor
            +swim()
        }
        class Shark {
            -int sizeInFeet
        }
    }
    Animal <|-- Turtle
    Animal <|-- Shark
    Animal : +int age
    Animal: +migrate()
