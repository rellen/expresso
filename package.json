{
  "name": "expresso-assets",
  "private": true,
  "description": "The tools for the presenter script. mix compile does not need them.",
  "scripts": {
    "check": "tsc -p assets",
    "lint": "oxlint --tsconfig assets/tsconfig.json assets/src assets/test",
    "test": "node --test \"assets/test/**/*.test.ts\"",
    "format": "prettier --write assets",
    "format:check": "prettier --check assets"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "pele": "1.13.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "temml": "0.14.0",
    "typescript": "7.0.2"
  }
}
